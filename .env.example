# Copy to .env next to compose.yaml. Docker Compose reads it automatically.

# Which release to run. Empty = the release this compose.yaml was published
# with. The admin console's server update page gives the exact line to set.
MULTITAP_VERSION=
# Published image (replace only for a mirror or your own registry).
# MULTITAP_IMAGE=ghcr.io/totblabs/multitap-broker

# Time zone of the server's days (the admin console's monitoring: today, the
# day charts and lists), an IANA name such as Europe/Berlin. Empty = UTC.
# install.sh writes this machine's time zone here when it creates .env.
TZ=

# This server's IP on your network, e.g. 192.168.0.10. Until an address is
# set, the first setup opens at http://<this IP>:<MULTITAP_PUBLISH_PORT>
# (the log prints the exact URL next to the one-time setup code).
MULTITAP_SERVER_ADDRESS=

# Docker host-published port (the container listener stays 18480).
# 0.0.0.0:18480 = every IPv4 interface: needed for HTTP and the first setup by
# IP. (Not plain 18480: Docker's IPv6 hop would arrive from the network gateway,
# the address a same-machine HTTPS proxy is trusted as.) HTTPS through a proxy
# on this machine only: 127.0.0.1:18480. An HTTP address made of this server's
# IP uses this port. After a change: docker compose up -d
MULTITAP_PUBLISH_PORT=0.0.0.0:18480

# The addresses apps and Hosts use are set in the admin console: Settings >
# Server access (addresses, the primary address, the trusted proxies, public
# IP following). The server keeps them in its data volume and applies a change
# itself. The lines below only start a server that has saved nothing there
# yet: once something is saved, they are not read.
# HTTPS (domain and certificate, usually a reverse proxy), e.g. https://vdi.example.com
MULTITAP_PUBLIC_ORIGIN=
# HTTP for the local network, e.g. http://192.168.0.10:18480. NO ENCRYPTION:
# passwords and screens travel in clear. Needs MULTITAP_ALLOW_INSECURE_HTTP=1.
# Up to four exact addresses, comma-separated.
MULTITAP_HTTP_ORIGIN=
MULTITAP_ALLOW_INSECURE_HTTP=0
# The reverse proxy as the container sees it (comma separated addresses).
# MULTITAP_TRUSTED_PROXIES=172.18.0.1

# Native TLS alternative (no reverse proxy): select the standalone file below.
# The supplied directory contains only cert.pem and key.pem, readable by 1000:1000
# and not writable by group/others. No utility generates or changes certificates.
# COMPOSE_FILE=compose.direct-https.yaml
# MULTITAP_TLS_DIRECTORY=/etc/multitap/supplied-tls

# Build from source instead of pulling (needs server/release-bundle/):
# COMPOSE_FILE=compose.yaml:compose.build.yaml

# The most memory the server container may use. Empty = 512m. More people
# connected at once need more, e.g. 1g. After a change: docker compose up -d
# MULTITAP_MEMORY_LIMIT=1g

# UDP media. The relay listens on UDP 18481 and Docker publishes it as
# MULTITAP_UDP_PUBLISH_PORT. Apps and Hosts send to the address they connected
# on, at that port, so it works once the firewall is open and the router
# forwards the UDP port. Where UDP does not arrive, sessions stay on WebSocket
# (over HTTPS or HTTP), which always works.
# MULTITAP_UDP_PUBLISH_PORT=18481
# Overrides, for a UDP address that differs from the one people connect on
# (for example an HTTPS name on a proxy or tunnel on another machine). With
# both lists and MULTITAP_UDP_MEDIA=on, Hosts and apps send to the listed
# addresses. With only one list, UDP stays off.
# MULTITAP_UDP_HOST_RELAYS=vdi.example.com:18481
# MULTITAP_UDP_CLIENT_RELAYS=vdi.example.com:18481
# MULTITAP_UDP_MEDIA=on
# Without the lists, MULTITAP_UDP_MEDIA=off keeps the screen on WebSocket (the
# UDP path is only tested).

# Server update check: the project's signed release feed. `off` disables the
# outbound check; another https URL selects a mirror of the same signed file.
# MULTITAP_DOCKER_UPDATE_FEED=off

# Separate data volume name (only for a second installation on one machine).
# MULTITAP_DATA_VOLUME=multitap-broker-data
