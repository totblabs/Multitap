NODE_ENV=production
MULTITAP_HOST=0.0.0.0
MULTITAP_PORT=18480
MULTITAP_DATA_DIR=/var/lib/multitap
MULTITAP_PUBLIC_ORIGIN=https://vdi.example.com
# Optional: which reverse proxy's X-Forwarded-For hop identifies the client for
# login/enrollment rate limits: exact proxy IP addresses separated by commas.
# Unset or "none" = the header is never trusted. (A saved 서버 접속 설정 /
# Server access policy supersedes this.)
# MULTITAP_TRUSTED_PROXIES=192.0.2.10
