#include <winver.h>
1 ICON "@MULTITAP_APP_ICON@"
@MULTITAP_EXTRA_ICONS@
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MULTITAP_RESOURCE_VERSION_NUMERIC@
 PRODUCTVERSION @MULTITAP_RESOURCE_VERSION_NUMERIC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "@MULTITAP_RESOURCE_DESCRIPTION@\0"
   VALUE "FileVersion", "@MULTITAP_RESOURCE_VERSION@\0"
   VALUE "ProductName", "@MULTITAP_RESOURCE_PRODUCT@\0"
   VALUE "ProductVersion", "@MULTITAP_RESOURCE_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
