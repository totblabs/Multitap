#!/usr/bin/env bash
# multitap: manage the Multitap server that deploy/docker/install.sh set up.
#   multitap status            what runs, its version and addresses
#   multitap logs              the server's log (Ctrl+C to stop)
#   multitap code              the one-time setup code again
#   multitap update [1.2.3]    back up, then move to the newest (or that) release
#   multitap backup            a copy of all server data in /opt/multitap/backups
#   multitap restore <file> [--yes]  put a backup back: a console backup file
#                              (.mtbk, asks its password) or a multitap backup copy
#   multitap address           the addresses apps and Hosts use. They are set in
#                              the admin console > Server access
#   multitap address <url>...  set them from here when the console cannot be
#                              reached (http://… or https://…; --help for more)
#   multitap public-ip [on|off] whether the server follows its public IP as an
#                              HTTP address (it checks every 10 minutes)
#   multitap restart | stop | start
#   multitap uninstall         stop and remove the server; the data stays
# Language: MULTITAP_LANG=ko|en, else the one install.sh kept in .env, else the
# locale (LC_ALL / LC_MESSAGES / LANG; Korean when it starts with ko).
set -euo pipefail

REPOSITORY=totblabs/Multitap
IMAGE_DEFAULT=ghcr.io/totblabs/multitap-broker
DIR=${MULTITAP_DIR:-/opt/multitap}
# Where systemd units live (another folder only in tests).
UNITS=${MULTITAP_UNIT_DIR:-/etc/systemd/system}
# How many of the copies `multitap update` makes by itself are kept (see backup).
UPDATE_COPIES=3

# Language (docs/i18n.md). .env is root-only: without root the locale decides.
saved_lang=$( { grep -E '^MULTITAP_LANG=' "$DIR/.env" 2>/dev/null | tail -n 1 | cut -d= -f2-; } || true)
case "${MULTITAP_LANG:-${saved_lang:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}}" in ko*|KO*) ML=ko ;; *) ML=en ;; esac
t() { if [ "$ML" = ko ]; then printf '%s' "$1"; else printf '%s' "$2"; fi; }
# shellcheck disable=SC2059
pf() { local ko=$1 en=$2; shift 2; if [ "$ML" = ko ]; then printf "$ko" "$@"; else printf "$en" "$@"; fi; }

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
  B=$'\033[1m' DIM=$'\033[2m' RED=$'\033[1;31m' GREEN=$'\033[1;32m' YELLOW=$'\033[1;33m' CYAN=$'\033[1;36m' OFF=$'\033[0m'
else
  B='' DIM='' RED='' GREEN='' YELLOW='' CYAN='' OFF=''
fi
ok() { printf '  %s✔%s %s\n' "$GREEN" "$OFF" "$*"; }
warn() { printf '  %s⚠%s %s\n' "$YELLOW" "$OFF" "$*"; }
say() { printf '  %s•%s %s\n' "$CYAN" "$OFF" "$*"; }
note() { printf '    %s%s%s\n' "$DIM" "$*" "$OFF"; }
fail() { printf '  %s✖ %s%s\n    %s\n' "$RED" "$(t '멈췄어요' 'Stopped')" "$OFF" "$*" >&2; exit 1; }

usage() {
  if [ "$ML" = ko ]; then
    cat <<'EOF'
multitap: install.sh로 설치한 Multitap 서버를 관리해요.
  multitap status            실행 상태, 버전, 주소
  multitap logs              서버 기록 (Ctrl+C로 멈춤)
  multitap code              처음 설정 코드 다시 보기
  multitap update [1.2.3]    백업한 뒤 새 버전(또는 그 버전)으로 올리기
  multitap backup            서버 데이터 전체를 /opt/multitap/backups에 복사
  multitap restore <파일> [--yes]  백업 되돌리기: 관리자 페이지 백업 파일(.mtbk,
                             백업 암호를 물어요) 또는 multitap backup 복사본
  multitap address           앱과 Host가 쓰는 주소 보기. 주소는 관리자 페이지 >
                             서버 접속 설정에서 정해요
  multitap address <주소>... 관리자 페이지에 못 들어갈 때 여기서 정하기
                             (http://… 또는 https://…, 자세히는 --help)
  multitap public-ip [on|off] 서버가 공인 IP를 HTTP 주소로 따라갈지 (10분마다 확인)
  multitap restart | stop | start
  multitap uninstall         서버를 멈추고 지우기. 데이터는 남아요
EOF
  else
    sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
  fi
}
restore_usage() {
  if [ "$ML" = ko ]; then
    cat <<'EOF'
sudo multitap restore <파일> [--yes]
  백업을 이 서버에 되돌려요. 파일은 둘 중 하나예요.
  - 관리자 페이지 > 백업·복원에서 받은 백업 파일(.mtbk): 백업 암호를 물어요.
    스크립트에서는 MULTITAP_BACKUP_PASSPHRASE 환경 변수로 줄 수 있어요.
    계정, 배정, Host 등록, Proxmox 연결, 사용 기록이 백업의 것으로 바뀌어요.
    접속 주소와 다운로드 파일은 이 서버 그대로예요.
  - multitap backup이 만든 복사본(.tar.gz): 데이터 전체가 그때로 돌아가요.
    접속 주소는 이 서버의 지금 것 그대로예요.
  바꾸기 전에 파일을 확인하고 요약을 보여 준 뒤 "복원할까요? [y/N]"를 물어요.
  --yes를 붙이면 묻지 않아요. 복원 전 데이터는 /opt/multitap/backups에 안전
  백업으로 남기고, 복원이 실패하면 그 안전 백업으로 되돌려요.
EOF
  else
    cat <<'EOF'
sudo multitap restore <file> [--yes]
  Puts a backup back on this server. The file is one of two kinds:
  - a backup file from the admin console > Backup and restore (.mtbk): it asks
    for the backup password. Scripts can give it in MULTITAP_BACKUP_PASSPHRASE.
    Accounts, assignments, Host registrations, the Proxmox connection and usage
    history become the backup's. The addresses and download files stay.
  - a copy made by multitap backup (.tar.gz): all data goes back to that time.
    The addresses stay as this server has them now.
  Before anything changes it checks the file, shows a summary and asks
  "Restore? [y/N]". --yes skips the question. The data before the restore is
  kept as a safety backup in /opt/multitap/backups, and a failed restore puts
  that safety backup back.
EOF
  fi
}
address_usage() {
  if [ "$ML" = ko ]; then
    cat <<'EOF'
sudo multitap address
  앱과 Host가 쓰는 주소를 보여 줘요. 주소, 기본 서버 주소, 신뢰할 프록시,
  공인 IP 따라가기는 관리자 페이지 > 서버 접속 설정에서 정해요.

sudo multitap address <주소>... [--primary <주소>] [--trusted-proxies <IP,IP|none>]
  관리자 페이지에 못 들어갈 때 같은 설정을 여기서 바꿔요. 넣은 주소가 지금
  주소를 모두 대신해요. HTTPS와 HTTP 각각 4개까지예요.
    multitap address http://192.168.0.10:18480
    multitap address https://vdi.example.com http://192.168.0.10:18480
  --primary          기본 서버 주소 (없으면 HTTPS 주소, HTTPS가 없으면 첫 주소)
  --trusted-proxies  신뢰할 프록시 IP (없으면 지금 값 그대로)
  --reset            읽을 수 없게 된 저장 설정을 지우고 새로 정하기
  HTTP 주소를 넣으면 Docker가 여는 포트도 그 주소의 포트로 맞춰요.
  공인 IP 따라가기가 켜져 있으면 따라가는 주소는 목록에 남아요.
  빼려면 먼저 multitap public-ip off 를 해요.
  서버를 다시 시작하고, 새 주소로 시작하지 못하면 전 설정으로 되돌려요.
EOF
  else
    cat <<'EOF'
sudo multitap address
  Shows the addresses apps and Hosts use. The addresses, the primary address,
  the trusted proxies and public IP following are set in the admin console >
  Server access.

sudo multitap address <url>... [--primary <url>] [--trusted-proxies <ip,ip|none>]
  Changes the same settings from here when the console cannot be reached. The
  addresses you give replace all current ones: up to 4 HTTPS and 4 HTTP.
    multitap address http://192.168.0.10:18480
    multitap address https://vdi.example.com http://192.168.0.10:18480
  --primary          the primary address (default: the HTTPS address, or the
                     first address when there is no HTTPS one)
  --trusted-proxies  the trusted proxy IPs (default: as they are now)
  --reset            remove saved settings that can no longer be read, then set
  With an HTTP address, the port Docker opens follows that address's port.
  While public IP following is on, the address it follows stays in the list.
  To drop it, run multitap public-ip off first.
  The server restarts; if it does not start with the new addresses, the
  previous settings come back.
EOF
  fi
}
# Help needs neither root nor an installed server.
case "${1:-}" in -h|--help|help) usage; exit 0 ;; esac
case "${1:-}" in restore|address) for arg in "${@:2}"; do case "$arg" in -h|--help) "${1}_usage"; exit 0 ;; esac; done ;; esac

[ "$(id -u)" = 0 ] || fail "$(t "root로 실행해 주세요." "Run this as root.")"
[ -f "$DIR/.env" ] && [ -f "$DIR/compose.yaml" ] || fail "$(t "$DIR 에 설치된 Multitap 서버가 없어요." "No Multitap server is installed in $DIR.")"

compose() { (cd "$DIR" && docker compose "$@"); }
# Whether somebody can be asked: the terminal has to open, not only be there
# (without one /dev/tty still passes the permission tests).
can_ask() { [ -r /dev/tty ] && [ -w /dev/tty ] && { true <> /dev/tty; } 2>/dev/null; }
env_value() { grep -E "^$1=" "$DIR/.env" | tail -n 1 | cut -d= -f2- || true; }
set_env() {
  if grep -q "^$1=" "$DIR/.env"; then sed -i "s|^$1=.*|$1=$2|" "$DIR/.env"; else printf '%s=%s\n' "$1" "$2" >> "$DIR/.env"; fi
}
image() { local value; value=$(env_value MULTITAP_IMAGE); printf '%s\n' "${value:-$IMAGE_DEFAULT}"; }
version() { env_value MULTITAP_VERSION; }
volume() { local value; value=$(env_value MULTITAP_DATA_VOLUME); printf '%s\n' "${value:-multitap-broker-data}"; }
running() { [ -n "$(compose ps -q --status running broker 2>/dev/null)" ]; }
kv() { sed -n "s/^$1=//p" <<< "$2" | head -n 1; }

# The server is up when its container runs the expected release and passes the
# image's own health check. Nothing is asked over the network from here, so
# the addresses in use (HTTPS only, another published port) make no difference.
#  - The release is the container's org.opencontainers.image.version label.
#    The image build refuses any value but the version in server/package.json.
#  - "healthy" is Docker's result of the image's HEALTHCHECK. That check asks
#    the server process inside the container, on its own listener, and passes
#    only when the answer carries that same package version and the access
#    settings in use.
# Together: the process that answers is the expected release. A container
# that keeps restarting is a failure at once, not after the whole wait.
container_line() {
  local id
  id=$(compose ps -aq broker 2>/dev/null | head -n 1 || true)
  [ -n "$id" ] || return 0
  docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{.RestartCount}} {{index .Config.Labels "org.opencontainers.image.version"}}' "$id" 2>/dev/null || true
}
wait_ready() { # wait_ready [release]: the release in .env unless another is named
  local want=${1:-$(version)} i state health restarts release
  for i in $(seq 1 90); do
    state='' health='' restarts='' release=''
    read -r state health restarts release <<< "$(container_line)" || true
    if [ "$state" = running ] && [ "$health" = healthy ] && [ "$release" = "$want" ]; then return 0; fi
    [ "$health" != unhealthy ] || return 1
    if [[ $restarts =~ ^[0-9]+$ ]] && [ "$restarts" -ge 2 ]; then return 1; fi
    sleep 2
  done
  return 1
}

newest_version() {
  local url
  url=$(curl -fsI -o /dev/null -w '%{redirect_url}' "https://github.com/$REPOSITORY/releases/latest" || true)
  case "$url" in
    */tag/v[0-9]*) printf '%s\n' "${url##*/tag/v}" ;;
    *) fail "$(t "새 버전을 확인하지 못했어요. 'multitap update 1.2.3'처럼 버전을 정해 주세요." "Could not find the newest release. Choose a version, e.g. 'multitap update 1.2.3'.")" ;;
  esac
}

# ---- server access -----------------------------------------------------------
# The addresses, the primary address, the trusted proxies and whether the
# public IP is followed are one saved setting: the policy in the data volume
# (access/policy.json), which the admin console's Server access page edits and
# the server applies itself. This command reads and writes that same policy
# through the server's own access-cli.mjs, in a one-off container of the
# service (its environment, its account, its volume), whether the server runs
# or is stopped. What only this machine can change stays in .env: the port
# Docker publishes (MULTITAP_PUBLISH_PORT).
#
# The address lines of .env (MULTITAP_PUBLIC_ORIGIN, MULTITAP_HTTP_ORIGIN,
# MULTITAP_ALLOW_INSECURE_HTTP) only start an install that has saved nothing
# yet; a saved policy supersedes them. This command empties them once the
# policy is saved, at the two moments it recreates the container anyway
# (`address <url>` and `update`), so that nothing beside the policy names an
# address. Lines left behind would be dead text while the policy exists and
# would come back to life, with addresses closed since, if it were ever
# removed. Without them a server that loses its policy opens only the first
# setup on its own IP until `multitap address <url>` is run. The copy
# .env.previous keeps the lines as they were.
#
# Going back to a release from before the saved policy (`update <older>`) is
# the other way round: that server reads only the .env lines, so the saved
# addresses are written there for it (write_env_seed). Left empty, it would
# start with no address at all and refuse every app and Host.
ACCESS=''
access() { # access <access-cli arguments>: its answer in $ACCESS; true when it is ok=1
  ACCESS=$(compose run --rm --no-deps -T --entrypoint node broker /app/src/access-cli.mjs "$@" 2>/dev/null < /dev/null || true)
  [ "$(kv ok "$ACCESS")" = 1 ]
}
# Whether the release named in .env has the saved policy and its command.
knows_policy() { docker run --rm --network none --entrypoint test "$(image):$(version)" -f /app/src/access-cli.mjs >/dev/null 2>&1; }
access_reason() { # access_reason <fixed code from access-cli.mjs; empty: no answer>
  case "$1" in
    '') if knows_policy; then
          t "서버 이미지가 답하지 않았어요. Docker가 실행 중인지 확인해 주세요." "The server image gave no answer. Check that Docker is running."
        else
          t "서버($(version))가 이 명령을 아직 몰라요. 먼저 올려 주세요: multitap update" "Server $(version) does not know this command yet. Update it first: multitap update"
        fi ;;
    server_access_unavailable) t "이 서버의 접속 설정은 이 명령으로 다루지 않아요." "This server's access settings are not managed by this command." ;;
    server_access_busy) t "관리자 페이지에서 저장한 설정을 적용하는 중이에요. 잠시 뒤 다시 해 주세요. 계속 그러면 multitap stop 뒤에 다시 실행해요." "A change saved in the admin console is still being applied. Try again in a moment. If it stays that way, run multitap stop and then this command again." ;;
    server_access_origin_invalid) t "주소를 확인해 주세요. 경로 없이 http:// 또는 https://로 시작하고, 같은 주소는 한 번만, HTTPS와 HTTP 각각 4개까지예요." "Check the addresses: http:// or https:// without a path, each address once, up to 4 HTTPS and 4 HTTP." ;;
    server_access_primary_origin_invalid) t "기본 서버 주소(--primary)는 넣은 주소 중 하나여야 해요." "The primary address (--primary) must be one of the addresses you gave." ;;
    server_access_trusted_proxies_invalid) t "신뢰할 프록시는 IP 주소로 넣어 주세요. 대역(10.0.0.0/8)은 안 돼요. 예: --trusted-proxies 172.18.0.1" "Give the trusted proxies as IP addresses, not ranges (10.0.0.0/8). Example: --trusted-proxies 172.18.0.1" ;;
    server_access_published_port_conflict) t "서버 IP로 만든 HTTP 주소는 모두 같은 포트여야 해요. Docker는 포트 하나만 열어요." "HTTP addresses made of the server's IP must all use one port. Docker opens a single port." ;;
    server_access_published_loopback_conflict) t "Docker 포트가 서버 안에서만 열려 있어요 ($DIR/.env 의 MULTITAP_PUBLISH_PORT)." "The Docker port is open only inside the server (MULTITAP_PUBLISH_PORT in $DIR/.env)." ;;
    server_access_direct_tls_http_conflict) t "서버가 직접 HTTPS를 받는 설치에서는 HTTP 주소를 함께 쓸 수 없어요." "An install where the server serves HTTPS itself cannot also use an HTTP address." ;;
    server_access_public_ip_conflict) t "공인 IP 따라가기는 다른 HTTP 주소가 하나 있어야 하고, 공인 IP 주소는 기본 서버 주소가 될 수 없어요." "Public IP following needs one other HTTP address, and the public IP address cannot be the primary address." ;;
    server_access_public_ip_invalid) t "공인 IP를 확인하지 못했어요." "Could not find the public IP." ;;
    server_access_revert_unavailable) t "되돌릴 전 설정이 없어요." "There are no previous settings to go back to." ;;
    server_access_state_invalid|server_access_storage_invalid|server_access_identity_invalid|server_access_identity_missing)
      pf '저장된 접속 설정을 읽지 못했어요 (%s). 지우고 새로 정하려면: multitap address --reset <주소>...' 'The saved access settings cannot be read (%s). To remove them and set new ones: multitap address --reset <url>...' "$1" ;;
    *) pf '처리하지 못했어요 (%s).' 'Could not do it (%s).' "$1" ;;
  esac
}
# A healthy container does not say that the saved access settings are in use.
# A policy the server cannot use (damaged, from another version, without its
# installation ID) does not stop it: it starts with no addresses and answers
# only the admin console, at http://<server address>:<published port>; apps,
# Hosts and downloads are refused. Only a file its account may not read at all
# (another owner or mode) still ends the start. `access show` fails with the
# reason in both cases; say_unusable says what that means and the ways out.
#
# Where the console of a server without addresses opens; nothing when it does
# not open that way (no server address in .env, or the port is published on
# this machine only).
console_address() {
  local address port
  address=$(env_value MULTITAP_SERVER_ADDRESS) port=$(env_value MULTITAP_PUBLISH_PORT)
  case "$port" in 127.*|localhost:*|\[::1\]:*) return 0 ;; esac
  port=${port##*:}
  [ -n "$address" ] || return 0
  case "$address" in *:*) address="[$address]" ;; esac
  printf 'http://%s:%s\n' "$address" "${port:-18480}"
}
# True for a code of `access show` that names saved settings the server could not use.
policy_unusable() { # policy_unusable <code>
  case "$1" in ''|server_access_unavailable|server_access_busy) return 1 ;; server_access_*) return 0 ;; *) return 1 ;; esac
}
say_unusable() { # say_unusable <code>
  local console
  warn "$(t "저장된 서버 접속 설정을 읽지 못했어요 ($1)." "The saved server access settings could not be read ($1).")"
  if [ "$1" = server_access_storage_invalid ]; then
    note "$(t "서버 계정이 읽을 수 없는 파일이라 서버가 시작하지 못해요." "The server's account cannot read the file, so the server cannot start.")"
    note "$(t "지우고 주소를 새로 정하려면: multitap address --reset <주소>..." "To remove it and set the addresses again: multitap address --reset <url>...")"
    return 0
  fi
  note "$(t "서버는 주소 없이 실행 중이에요. 앱과 Host는 접속할 수 없어요." "The server is running without addresses. Apps and Hosts cannot connect.")"
  console=$(console_address)
  [ -z "$console" ] || note "$(t "관리자 페이지는 $console 에서 열려요. 로그인해서 서버 접속 설정에서 주소를 다시 저장해요." "The admin console is open at $console. Sign in there and save the addresses again in Server access.")"
  note "$(t "여기서 새로 정하려면: multitap address --reset <주소>..." "To set them from here: multitap address --reset <url>...")"
}
# Ends the command with the reason of the last answer; saved settings that did not load get the plain explanation.
access_stop() {
  local code
  code=$(kv code "$ACCESS")
  case "$code" in server_access_state_invalid|server_access_storage_invalid|server_access_identity_invalid|server_access_identity_missing) say_unusable "$code" >&2; exit 1 ;; esac
  fail "$(access_reason "$code")"
}
# After a wait: the server answers, but with its saved settings? True when it had to say that it does not.
unusable_policy() {
  if access show || ! policy_unusable "$(kv code "$ACCESS")"; then return 1; fi
  say_unusable "$(kv code "$ACCESS")"
}
# `access-cli reset` removes the saved policy as the server's own account. A
# file that account may not even read it cannot remove: root does it here and
# gives the folder back to the server's account (the installation ID stays).
clear_access() {
  docker run --rm --network none --user 0 --entrypoint sh -v "$(volume):/data" "$(image):$(version)" \
    -c "rm -f /data/access/policy.json /data/access/journal.json /data/access/policy.before-cli.json && chown -R $BROKER_UID:$BROKER_GID /data/access && chmod -R u=rwX,go= /data/access" >/dev/null 2>&1
}
# One line per address of an access-cli answer, the primary and the followed one marked.
list_addresses() { # list_addresses <answer>
  local primary followed item mark items
  primary=$(kv primary "$1") followed=$(kv followed "$1")
  IFS=',' read -r -a items <<< "$(kv https "$1"),$(kv http "$1")"
  for item in "${items[@]}"; do
    [ -n "$item" ] || continue
    mark=''
    [ "$item" != "$primary" ] || mark=$(t ' (기본 서버 주소)' ' (primary)')
    [ "$item" != "$followed" ] || mark=$(t ' (공인 IP 따라가기)' ' (follows the public IP)')
    note "$item$mark"
  done
}
# The addresses in use, or where the first setup opens while there is none yet.
show_addresses() { # show_addresses <answer>
  if [ -n "$(kv primary "$1")" ]; then
    list_addresses "$1"
  elif [ -n "$(kv serverAddress "$1")" ] && [ -n "$(kv publishedPort "$1")" ]; then
    note "$(t "아직 없어요. 처음 설정은 http://$(kv serverAddress "$1"):$(kv publishedPort "$1") 에서 열려요." "None yet. The first setup opens at http://$(kv serverAddress "$1"):$(kv publishedPort "$1")")"
  else
    note "$(t "아직 없어요." "None yet.")"
  fi
}
drop_env_seed() {
  local name
  for name in MULTITAP_PUBLIC_ORIGIN MULTITAP_HTTP_ORIGIN; do [ -z "$(env_value "$name")" ] || set_env "$name" ''; done
  [ "$(env_value MULTITAP_ALLOW_INSECURE_HTTP)" != 1 ] || set_env MULTITAP_ALLOW_INSECURE_HTTP 0
}
# The saved addresses as the .env lines an earlier release starts from: its
# one HTTPS address (the first), the HTTP addresses, and the trusted proxies
# an HTTPS address needs.
write_env_seed() { # write_env_seed <access-cli answer>
  local https http
  https=$(kv https "$1") http=$(kv http "$1")
  set_env MULTITAP_PUBLIC_ORIGIN "${https%%,*}"
  set_env MULTITAP_HTTP_ORIGIN "$http"
  if [ -n "$http" ]; then set_env MULTITAP_ALLOW_INSECURE_HTTP 1; else set_env MULTITAP_ALLOW_INSECURE_HTTP 0; fi
  [ -z "$https" ] || set_env MULTITAP_TRUSTED_PROXIES "$(kv trustedProxies "$1")"
}
# The port Docker must open for these addresses: the port of the HTTP address
# on the server's own IP, else of the first HTTP address. Empty without HTTP.
publish_port() { # publish_port <address>...
  local own value rest host port first=''
  own=$(env_value MULTITAP_SERVER_ADDRESS)
  for value in "$@"; do
    case "$value" in http://*) ;; *) continue ;; esac
    rest=${value#http://} port=80
    if [[ $rest =~ ^(.*):([0-9]{1,5})$ ]]; then host=${BASH_REMATCH[1]} port=${BASH_REMATCH[2]}; else host=$rest; fi
    [ -n "$first" ] || first=$port
    if [ -n "$own" ] && [ "$host" = "$own" ]; then printf '%s\n' "$port"; return; fi
  done
  printf '%s\n' "$first"
}

# ---- following the public IP -----------------------------------------------
# The server asks for its public IP itself every ten minutes while following
# is on (the switch is part of the saved policy). This machine's own lookup
# only tells `public-ip on` which listed address is the public one already.
public_ipv4() { # true for a public IPv4 (not private, shared, link-local or loopback)
  [[ ${1:-} =~ ^([0-9]{1,3})\.([0-9]{1,3})\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
  local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
  if [ "$a" = 10 ] || [ "$a" = 127 ] || [ "$a" = 0 ] || { [ "$a" = 172 ] && [ "$b" -ge 16 ] && [ "$b" -le 31 ]; } || { [ "$a" = 192 ] && [ "$b" = 168 ]; } || { [ "$a" = 100 ] && [ "$b" -ge 64 ] && [ "$b" -le 127 ]; } || { [ "$a" = 169 ] && [ "$b" = 254 ]; }; then return 1; fi
}
public_ip() { # this machine's public IPv4 from Cloudflare's address echo; empty when it cannot be known
  local ip
  ip=$( { curl -fs --max-time 5 https://1.1.1.1/cdn-cgi/trace 2>/dev/null | sed -n 's/^ip=//p'; } || true)
  if public_ipv4 "$ip"; then printf '%s\n' "$ip"; fi
}
# Release 1.1.1 followed the public IP from this machine: a systemd timer ran
# `multitap public-ip sync` every ten minutes and kept the address in .env,
# with the IP it had registered in $DIR/public-ip. An install that still has
# that timer is moved over once: following is turned on in the saved policy,
# naming the address the timer registered, and then the timer is removed.
# Nothing restarts: the running server reads the switch at its next round.
# After an update made by the 1.1.1 command (which never runs this file) the
# timer's own next tick does it, through `public-ip sync` below.
host_timer() { [ -e "$UNITS/multitap-public-ip.timer" ] || [ -e "$UNITS/multitap-public-ip.service" ]; }
remove_host_timer() {
  systemctl disable --now multitap-public-ip.timer >/dev/null 2>&1 || true
  rm -f "$UNITS/multitap-public-ip.service" "$UNITS/multitap-public-ip.timer" "$DIR/public-ip"
  systemctl daemon-reload >/dev/null 2>&1 || true
}
follow_router_note() { # follow_router_note <answer>
  note "$(t "공유기에서 TCP $(kv publishedPort "$1"), UDP 18481을 이 서버로 포트 포워딩해야 밖에서 들어와요." "Connections from outside arrive only after your router forwards TCP $(kv publishedPort "$1") and UDP 18481 to this server.")"
}
adopt_host_timer() { # adopt_host_timer [quiet]: quiet says nothing unless it moved the setting
  host_timer || return 0
  local stored arguments=(public-ip on)
  stored=$(cat "$DIR/public-ip" 2>/dev/null || true)
  if public_ipv4 "$stored"; then arguments+=(--address "$stored"); fi
  if access "${arguments[@]}"; then
    remove_host_timer
    ok "$(t "공인 IP 따라가기를 서버가 직접 하도록 옮겼어요. 전에 쓰던 10분 타이머는 지웠어요." "Public IP following is now done by the server itself. The earlier 10-minute timer is removed.")"
    return 0
  fi
  [ "${1:-}" != quiet ] || return 0
  case "$(kv code "$ACCESS")" in
    # An older server, or a save in flight: the next run tries again.
    ''|server_access_busy) ;;
    server_access_public_ip_conflict)
      warn "$(t "공인 IP 따라가기를 서버로 옮기지 못했어요. 지금 주소로는 따라갈 수 없어요." "Public IP following could not be moved into the server. It cannot work with the current addresses.")"
      note "$(t "따라가려면 다른 HTTP 주소가 하나 있어야 하고, 공인 IP 주소가 기본 서버 주소면 안 돼요." "It needs one other HTTP address, and the public IP address must not be the primary address.")"
      note "$(t "관리자 페이지 > 서버 접속 설정에서 HTTP 주소를 넣고 ‘공인 IP 따라가기’를 켜 주세요. 쓰지 않으려면: multitap public-ip off" "In the admin console > Server access, add an HTTP address and turn on “Follow the public IP”. To stop using it: multitap public-ip off")" ;;
    *) warn "$(t "공인 IP 따라가기를 서버로 옮기지 못했어요: $(access_reason "$(kv code "$ACCESS")")" "Public IP following could not be moved into the server: $(access_reason "$(kv code "$ACCESS")")")" ;;
  esac
}

# ---- backup ----------------------------------------------------------------
# The whole data volume (accounts, assignments, Host registrations, vault key,
# downloads, access settings), with the server stopped for the moment of the
# copy. The file holds the vault key: it stays root-only in $DIR/backups.
#
# `without-installers` leaves out the app and Host setup files in downloads/
# (*.exe, *.apk). They are most of the volume: every release this server has
# run keeps its files there, about 150 MB each. They never change once
# written, the server never deletes them, and the list that names them
# (downloads/releases.json) stays in the copy. So on this same server such a
# copy still goes back exactly: restore leaves the files in the volume where
# they are and puts the list back. The copy `multitap update` makes is of
# that kind; `multitap backup` copies everything, because that file is also
# what moves a server to another machine, where the files of earlier
# releases exist nowhere else.
#
# The archive is written in the POSIX (pax) format, which keeps file times to
# the fraction of a second. The server dates a release by its setup file's
# time, to the millisecond: a copy that rounds the times to whole seconds
# would, once restored, give every release another date than the one recorded
# (the server then logs "conflicts" at each start).
save_volume() { # save_volume <file name in $DIR/backups> [without-installers]; the server is already stopped
  local skip=()
  [ "${2:-}" != without-installers ] || skip=(--anchored '--exclude=./downloads/*.exe' '--exclude=./downloads/*.apk')
  install -d -m 0700 "$DIR/backups"
  if docker run --rm --network none --user 0 --entrypoint tar \
      -v "$(volume):/data:ro" -v "$DIR/backups:/out" "$(image):$(version)" \
      --format=posix -czf "/out/$1" ${skip[@]+"${skip[@]}"} -C /data . ; then
    chmod 0600 "$DIR/backups/$1"
  else
    rm -f "$DIR/backups/$1"
    return 1
  fi
}
# Three kinds of copy share $DIR/backups, told apart by their names:
#   multitap-data-<version>-<date>-<time>.tar.gz                 made by `multitap backup`
#   multitap-data-<version>-<date>-<time>-before-update.tar.gz   made by `multitap update`
#   multitap-data-<version>-<date>-<time>-before-restore.tar.gz  made by `multitap restore`
# Only the before-update copies are removed by this command: the newest
# UPDATE_COPIES stay. Three keep the way back over the last three updates,
# long enough to notice a release that went wrong, and they are small (no
# installer files, see save_volume). A copy someone asked for, and a
# restore's safety copy, are never removed here.
backup() { # backup [update]: `update` is the copy made before an update; it leaves the server stopped
  local file was_running=no kind=${1:-}
  file="multitap-data-$(version)-$(date +%Y%m%d-%H%M%S)${kind:+-before-$kind}.tar.gz"
  running && was_running=yes
  [ "$was_running" = yes ] && compose stop broker >/dev/null 2>&1
  if ! save_volume "$file" ${kind:+without-installers}; then
    [ "$was_running" = yes ] && compose start broker >/dev/null 2>&1
    fail "$(t "데이터를 복사하지 못했어요. 서버는 그대로예요." "Could not copy the data. The server is unchanged.")"
  fi
  # The server is back before this returns: a command right after it finds it
  # answering. (An update starts the new release instead.)
  if [ "$was_running" = yes ] && [ "$kind" != update ]; then compose start broker >/dev/null 2>&1; wait_ready || true; fi
  ok "$(t "데이터를 백업했어요: $DIR/backups/$file" "Data backed up: $DIR/backups/$file")"
}
prune_update_copies() {
  local path name rows=() old
  for path in "$DIR"/backups/multitap-data-*-before-update.tar.gz; do
    name=${path##*/}
    if [ -f "$path" ] && [[ $name =~ ^multitap-data-[0-9]+\.[0-9]+\.[0-9]+-([0-9]{8}-[0-9]{6})-before-update\.tar\.gz$ ]]; then rows+=("${BASH_REMATCH[1]} $name"); fi
  done
  [ "${#rows[@]}" -gt "$UPDATE_COPIES" ] || return 0
  # Newest first by the time in the name; everything after the kept ones goes.
  while read -r _ old; do
    rm -f "$DIR/backups/$old"
    note "$(t "오래된 업데이트 전 백업을 지웠어요: $old" "Removed an old pre-update backup: $old")"
  done < <(printf '%s\n' "${rows[@]}" | sort -r | tail -n +"$((UPDATE_COPIES + 1))")
}

# After an update that answers: the server images of releases older than the
# two that are kept, the one running now and the one before it (the way back).
older_release() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]; }
prune_images() { # prune_images <release now> <release before>
  local tag
  while read -r tag; do
    [[ $tag =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    if older_release "$tag" "$1" && older_release "$tag" "$2" && docker image rm "$(image):$tag" >/dev/null 2>&1; then
      note "$(t "오래된 서버 이미지를 지웠어요: $tag" "Removed an old server image: $tag")"
    fi
  done < <(docker image ls --format '{{.Tag}}' "$(image)" 2>/dev/null || true)
}
# Free space where Docker keeps the volume and the images. An update needs
# room for the new image and for the copy it makes first.
LOW_SPACE_KB=2097152 # 2 GB
disk_space() {
  local root free gigabytes
  root=$(docker info -f '{{.DockerRootDir}}' 2>/dev/null || true)
  [ -n "$root" ] && [ -d "$root" ] || root=$DIR
  free=$( { df -Pk "$root" 2>/dev/null | awk 'NR == 2 { print $4 }'; } || true)
  [[ $free =~ ^[0-9]+$ ]] || return 0
  gigabytes=$(awk -v kb="$free" 'BEGIN { printf "%.1f", kb / 1048576 }')
  note "$(t "남은 디스크 공간: $gigabytes GB ($root)" "Free disk space: $gigabytes GB ($root)")"
  if [ "$free" -lt "$LOW_SPACE_KB" ]; then
    warn "$(t "디스크 공간이 얼마 안 남았어요. 업데이트와 백업에 공간이 필요해요." "Disk space is low. Updates and backups need room.")"
    note "$(t "필요 없는 백업은 $DIR/backups 에서 지울 수 있어요." "Backups you no longer need can be deleted from $DIR/backups.")"
  fi
}

# ---- restore ---------------------------------------------------------------
# Two kinds of file. A console backup (.mtbk, encrypted with its passphrase) is
# read by the server's own restore code (src/restore-cli.mjs) in a one-off
# container of this image: it replaces the database and the vault key, as the
# console's restore does on a systemd install; the rest of the volume and .env
# stay. A `multitap backup` copy replaces the volume. Either way the volume is
# copied first (the safety backup) and put back if anything fails.
#
# The access settings (access/ in the volume) are this server's own after
# either kind of restore, as they were before it:
#  - A copy from another server names that machine's addresses and carries
#    its installation ID. Unpacked here they would make this server answer
#    only at addresses it does not have, as a second copy of the other one.
#  - A copy of this same server is older than its addresses: they describe
#    the network as it is now (a domain added since, the public IP followed
#    since), and going back to that time must not close the way in.
# So a restore never changes how the server is reached. Only the automatic way
# back from the safety backup puts the volume back whole, access/ included:
# that copy is this server a moment ago.
BROKER_UID=1000 BROKER_GID=1000 # compose.yaml's user
WORK="$DIR/restore-work"        # $DIR is root-only (0750 root): no other account reaches it

# The CLI as the server's own account, without network. stdin goes to it.
restore_cli() { # restore_cli <mount the data volume: yes|no> <arguments...>
  local data=$1 mounts
  shift
  mounts=(-v "$WORK:/restore")
  [ "$data" = yes ] && mounts+=(-v "$(volume):/var/lib/multitap")
  docker run --rm -i --network none --user "$BROKER_UID:$BROKER_GID" --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m --cap-drop ALL --security-opt no-new-privileges \
    --pids-limit 128 --memory 768m "${mounts[@]}" \
    --entrypoint node "$(image):$(version)" /app/src/restore-cli.mjs "$@"
}
# A `multitap backup` copy holds only names inside the data folder, and only
# regular files and folders: no link, hard link, device or pipe.
plain_copy() { # plain_copy <file>
  local names types
  names=$(tar tzf "$1" 2>/dev/null) || return 1
  if grep -qE '^/|(^|/)\.\.(/|$)' <<< "$names"; then return 1; fi
  types=$(tar tvzf "$1" 2>/dev/null | cut -c1 | sort -u | tr -d '\n') || return 1
  [[ $types =~ ^[-d]+$ ]]
}
# The volume replaced by a `multitap backup` copy. Root only empties the
# volume and gives it to the server's account; the copy is unpacked as that
# account, without the owners and modes it records. `whole` replaces
# everything. `keep` leaves two things of the volume where they are:
#  - its own access/ folder, and unpacks none from the copy (see above);
#  - the installer files in downloads/ (*.exe, *.apk). A copy made before an
#    update does not carry them (save_volume), and they only ever get added,
#    so the ones the copy's list names are there. A copy that does carry them
#    writes its own over them.
put_volume() { # put_volume <file> <keep|whole>
  local empty unpack=()
  plain_copy "$1" || { warn "$(t "이 복사본에는 보통 파일과 폴더가 아닌 것이 있어요." "This copy holds something other than plain files and folders.")"; return 1; }
  if [ "$2" = keep ]; then
    empty="find /data -mindepth 1 ! -path /data/access ! -path '/data/access/*' ! -path /data/downloads ! -path '/data/downloads/*.exe' ! -path '/data/downloads/*.apk' -delete"
    unpack=(--anchored --exclude=./access --exclude=access)
  else
    empty='find /data -mindepth 1 -delete'
  fi
  docker run --rm --network none --user 0 --entrypoint sh -v "$(volume):/data" "$(image):$(version)" \
    -c "$empty && chown $BROKER_UID:$BROKER_GID /data" || return 1
  docker run --rm -i --network none --user "$BROKER_UID:$BROKER_GID" --cap-drop ALL --security-opt no-new-privileges --entrypoint tar \
    -v "$(volume):/data" "$(image):$(version)" xzf - -C /data --no-same-owner --no-same-permissions ${unpack[@]+"${unpack[@]}"} < "$1"
}
restore_reason() { # restore_reason <fixed code from restore-cli.mjs>
  case "$1" in
    backup_unreadable) t "백업 암호가 다르거나 파일이 손상됐어요." "The backup password is wrong or the file is damaged." ;;
    backup_passphrase_too_short) t "백업 암호는 12자 이상이에요." "The backup password has 12 or more characters." ;;
    backup_passphrase_invalid) t "백업 암호를 읽지 못했어요." "Could not read the backup password." ;;
    backup_file_invalid) t "Multitap 백업 파일이 아니거나 손상된 파일이에요." "This is not a Multitap backup file, or it is damaged." ;;
    backup_format_newer|backup_from_newer_server|backup_schema_newer) t "이 서버보다 새 버전에서 만든 백업이에요. 먼저 서버를 올려 주세요: multitap update" "A newer server version made this backup. Update this server first: multitap update" ;;
    backup_too_large) t "백업이 너무 커요." "The backup is too large." ;;
    backup_database_invalid) t "백업 안의 데이터가 손상됐어요." "The data in the backup is damaged." ;;
    backup_database_unsupported) t "백업에 이 서버가 다루지 않는 내용이 있어요." "The backup holds content this server does not handle." ;;
    backup_no_administrator) t "백업에 쓸 수 있는 관리자 계정이 없어요." "The backup has no usable administrator account." ;;
    backup_helper_timeout) t "백업 파일을 처리하는 데 너무 오래 걸렸어요." "Reading the backup file took too long." ;;
    restore_staging_changed|restore_staging_invalid) t "확인한 복원 파일이 그 뒤에 바뀌었어요." "The checked restore files changed afterwards." ;;
    '') t "복원 프로그램이 답하지 않았어요." "The restore program gave no answer." ;;
    *) pf '처리하지 못했어요 (%s).' 'Could not process it (%s).' "$1" ;;
  esac
}
show_time() { date -d "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '%s' "$1"; }

restore() {
  local file='' yes=no arg kind magic out passphrase='' answer when made_by list name names=() safety reason='' origin
  for arg in "$@"; do
    case "$arg" in
      --yes|-y) yes=yes ;;
      -*) fail "$(t "모르는 옵션이에요: $arg  (multitap restore --help)" "Unknown option: $arg  (multitap restore --help)")" ;;
      *) [ -z "$file" ] || fail "$(t "파일은 하나만 정해 주세요." "Name one file only.")"; file=$arg ;;
    esac
  done
  [ -n "$file" ] || fail "$(t "복원할 파일을 정해 주세요: sudo multitap restore <파일>" "Name the file to restore: sudo multitap restore <file>")"
  [ -f "$file" ] && [ -r "$file" ] || fail "$(t "파일을 읽을 수 없어요: $file  아무것도 바꾸지 않았어요." "Cannot read the file: $file  Nothing was changed.")"
  magic=$(head -c 8 "$file" | od -An -tx1 | tr -d ' \n')
  case "$magic" in
    894d54424b0d0a1a) kind=console ;;
    1f8b*) kind=volume ;;
    *) fail "$(t "Multitap 백업 파일이 아니에요: $file  아무것도 바꾸지 않았어요." "Not a Multitap backup file: $file  Nothing was changed.")" ;;
  esac
  docker image inspect "$(image):$(version)" >/dev/null 2>&1 || fail "$(t "서버 이미지($(version))가 없어요. 아무것도 바꾸지 않았어요." "The server image $(version) is missing. Nothing was changed.")"
  rm -rf "$WORK"
  install -d -m 0700 -o "$BROKER_UID" -g "$BROKER_GID" "$WORK"
  # The decrypted database and its vault key never outlive this command.
  trap 'rm -rf "$WORK"' EXIT

  say "$(t "백업 파일을 확인해요. 아직 아무것도 바꾸지 않아요." "Checking the backup file. Nothing changes yet.")"
  if [ "$kind" = console ]; then
    docker run --rm --network none --entrypoint test "$(image):$(version)" -f /app/src/restore-cli.mjs \
      || fail "$(t "서버($(version))는 백업 파일 복원을 아직 못 해요. 먼저 올려 주세요: multitap update" "Server $(version) cannot restore backup files yet. Update it first: multitap update")"
    if [ -n "${MULTITAP_BACKUP_PASSPHRASE:-}" ]; then
      passphrase=$MULTITAP_BACKUP_PASSPHRASE
    elif can_ask; then
      printf '  %s ' "$(t "백업 암호:" "Backup password:")" > /dev/tty
      IFS= read -r -s passphrase < /dev/tty || passphrase=''
      printf '\n' > /dev/tty
    else
      fail "$(t "백업 암호를 물을 수 없어요. MULTITAP_BACKUP_PASSPHRASE로 주세요." "Cannot ask for the backup password. Give it in MULTITAP_BACKUP_PASSPHRASE.")"
    fi
    unset MULTITAP_BACKUP_PASSPHRASE
    install -o "$BROKER_UID" -g "$BROKER_GID" -m 0600 "$file" "$WORK/backup.mtbk"
    # The passphrase reaches the CLI on its stdin: never an argument, never the environment.
    out=$(printf '%s\n' "$passphrase" | restore_cli no inspect --input /restore/backup.mtbk --work /restore --passphrase-stdin) || true
    passphrase=''
    rm -f "$WORK/backup.mtbk"
  else
    list=$(tar tzf "$file" 2>/dev/null) || fail "$(t "백업 복사본이 손상됐어요: $file" "The backup copy is damaged: $file")"
    if grep -qE '^/|(^|/)\.\.(/|$)' <<< "$list"; then fail "$(t "이 복사본에는 데이터 폴더 밖을 가리키는 이름이 있어요." "This copy has names that point outside the data folder.")"; fi
    plain_copy "$file" || fail "$(t "이 복사본에는 보통 파일과 폴더가 아닌 것이 있어요. 아무것도 바꾸지 않았어요." "This copy holds something other than plain files and folders. Nothing was changed.")"
    for name in broker.sqlite vault.key broker.sqlite-wal; do
      if grep -qxF "./$name" <<< "$list"; then names+=("./$name")
      elif grep -qxF "$name" <<< "$list"; then names+=("$name")
      elif [ "$name" != broker.sqlite-wal ]; then fail "$(t "multitap backup 복사본이 아니에요 ($name 없음). 아무것도 바꾸지 않았어요." "Not a multitap backup copy (no $name). Nothing was changed.")"
      fi
    done
    install -d -m 0700 -o "$BROKER_UID" -g "$BROKER_GID" "$WORK/volume"
    tar xzf "$file" -C "$WORK/volume" --no-same-owner --no-same-permissions "${names[@]}" || fail "$(t "백업 복사본을 읽지 못했어요." "Could not read the backup copy.")"
    chown -R "$BROKER_UID:$BROKER_GID" "$WORK/volume"
    out=$(restore_cli no inspect-volume --work /restore < /dev/null) || true
  fi
  [ "$(kv ok "$out")" = 1 ] || fail "$(restore_reason "$(kv code "$out")") $(t "아무것도 바꾸지 않았어요." "Nothing was changed.")"

  # What is about to happen, in a few lines.
  printf '\n'
  if [ "$kind" = console ]; then
    ok "$(t "관리자 페이지 백업 파일이에요. 암호가 맞고 파일이 온전해요." "A backup file from the admin console. The password is right and the file is intact.")"
    when=$(show_time "$(kv createdAt "$out")") made_by=$(kv serverVersion "$out")
  else
    ok "$(t "multitap backup 복사본이에요. 파일이 온전해요." "A multitap backup copy. The file is intact.")"
    if [[ $(basename "$file") =~ ^multitap-data-([0-9]+\.[0-9]+\.[0-9]+)-([0-9]{8})-([0-9]{2})([0-9]{2})([0-9]{2}) ]]; then
      made_by=${BASH_REMATCH[1]} when="${BASH_REMATCH[2]:0:4}-${BASH_REMATCH[2]:4:2}-${BASH_REMATCH[2]:6:2} ${BASH_REMATCH[3]}:${BASH_REMATCH[4]}"
    else
      made_by=$(t '알 수 없음' 'unknown') when=$(date -r "$file" '+%Y-%m-%d %H:%M')
    fi
  fi
  note "$(t "만든 때: $when   서버 버전: $made_by" "Made: $when   Server version: $made_by")"
  [ -n "$(kv origin "$out")" ] && note "$(t "백업한 서버의 주소: $(kv origin "$out") (이 서버 주소는 바뀌지 않아요)" "Address of the server it came from: $(kv origin "$out") (this server's address does not change)")"
  note "$(t "계정 $(kv accounts "$out")개 (관리자 $(kv admins "$out")) · 데스크톱 $(kv desktops "$out")개 · 배정 $(kv assignments "$out")개 · Host $(kv hosts "$out")개" \
            "$(kv accounts "$out") accounts ($(kv admins "$out") admins) · $(kv desktops "$out") desktops · $(kv assignments "$out") assignments · $(kv hosts "$out") Hosts")"
  case "$(kv proxmox "$out")" in
    readable) note "$(t "Proxmox 연결: $(kv proxmoxEndpoint "$out")" "Proxmox connection: $(kv proxmoxEndpoint "$out")")" ;;
    unreadable) warn "$(t "Proxmox 연결 정보를 열 수 없어요. 복원한 뒤 다시 연결해 주세요." "The Proxmox connection cannot be opened. Connect it again after the restore.")" ;;
    *) note "$(t "Proxmox 연결: 없음" "Proxmox connection: none")" ;;
  esac
  [ "$(kv unreadableSecrets "$out")" -gt 0 ] 2>/dev/null && warn "$(t "열 수 없는 비밀 값이 $(kv unreadableSecrets "$out")개 있어요. 그 값은 다시 설정해야 해요." "$(kv unreadableSecrets "$out") secret values cannot be opened. They need to be set again.")"
  [ "$(kv migrated "$out")" = 1 ] && note "$(t "이전 버전의 데이터예요. 이 버전 형식으로 바꿔서 복원해요." "Data from an earlier version. It is brought up to this version.")"
  if [ "$kind" = console ]; then
    note "$(t "바뀌는 것: 계정, 배정, Host 등록, Proxmox 연결, 사용 기록이 백업의 것으로" "Replaced: accounts, assignments, Host registrations, the Proxmox connection and usage history, by the backup's")"
    note "$(t "그대로인 것: 접속 주소, 다운로드 파일" "Kept: the addresses and the download files")"
    note "$(t "백업에 없는 것: 지금의 로그인(모두 다시 로그인), 공지, 진단 기록" "Not in a backup: current sign-ins (everyone signs in again), notices, diagnostics")"
  else
    note "$(t "데이터 볼륨 전체가 그때로 돌아가요. 접속 주소는 이 서버의 지금 것 그대로예요." "The whole data volume goes back to that time. The addresses stay as this server has them now.")"
    if ! grep -qE '(^|/)downloads/[^/]+\.(exe|apk)$' <<< "$list"; then
      note "$(t "업데이트 전에 만든 복사본이라 앱·Host 설치 파일은 들어 있지 않아요. 서버에 있는 파일을 그대로 써요." "A copy made before an update: it carries no app or Host setup files. The ones on this server stay in use.")"
    fi
  fi
  note "$(t "지금 데이터는 복원 전에 $DIR/backups 에 안전 백업으로 남겨요. 서버는 잠시 멈춰요." "The current data is kept as a safety backup in $DIR/backups first. The server stops for a moment.")"
  if [ "$yes" != yes ]; then
    can_ask || fail "$(t "확인을 물을 수 없어요. 묻지 않고 하려면 --yes를 붙여 주세요. 아무것도 바꾸지 않았어요." "Cannot ask for confirmation. To go ahead without asking, add --yes. Nothing was changed.")"
    printf '\n  %s?%s %s ' "$YELLOW" "$OFF" "$(t "복원할까요? [y/N]" "Restore? [y/N]")" > /dev/tty
    read -r answer < /dev/tty || answer=''
    case "$answer" in y|Y|yes|Yes|YES) ;; *) ok "$(t "취소했어요. 아무것도 바꾸지 않았어요." "Cancelled. Nothing was changed.")"; exit 0 ;; esac
  fi

  # From here on, anything that fails puts the safety backup back.
  say "$(t "서버를 멈추고 지금 데이터를 안전 백업해요." "Stopping the server and keeping a safety backup of the current data.")"
  compose stop broker >/dev/null 2>&1 || fail "$(t "서버를 멈추지 못했어요. 아무것도 바꾸지 않았어요." "Could not stop the server. Nothing was changed.")"
  safety="multitap-data-$(version)-$(date +%Y%m%d-%H%M%S)-before-restore.tar.gz"
  if ! save_volume "$safety"; then
    compose up -d >/dev/null 2>&1 || true
    fail "$(t "안전 백업을 만들지 못해 복원하지 않았어요. 서버는 그대로예요 (다시 시작함)." "Could not make the safety backup, so nothing was restored. The server is unchanged (started again).")"
  fi
  ok "$(t "안전 백업: $DIR/backups/$safety" "Safety backup: $DIR/backups/$safety")"
  say "$(t "복원해요." "Restoring.")"
  if [ "$kind" = console ]; then
    # The restore record names this server's own primary address. A server
    # from before the saved policy has it in its .env lines.
    if access show; then origin=$(kv primary "$ACCESS")
    else origin=$(env_value MULTITAP_PUBLIC_ORIGIN); [ -n "$origin" ] || origin=$(env_value MULTITAP_HTTP_ORIGIN | cut -d, -f1); fi
    out=$(restore_cli yes apply --work /restore --data /var/lib/multitap ${origin:+--origin "$origin"} < /dev/null) || true
    [ "$(kv ok "$out")" = 1 ] || reason=$(restore_reason "$(kv code "$out")")
  else
    put_volume "$file" keep || reason=$(t "백업 복사본을 데이터 볼륨에 풀지 못했어요." "Could not unpack the backup copy into the data volume.")
  fi
  rm -rf "$WORK"
  if [ -z "$reason" ]; then
    compose up -d >/dev/null 2>&1 || true
    say "$(t "복원한 서버가 응답하기를 기다려요." "Waiting for the restored server to answer.")"
    if wait_ready; then
      ok "$(t "복원했어요. 서버($(version))가 응답해요." "Restored. Server $(version) is answering.")"
      if [ "$kind" = console ]; then note "$(t "모두 다시 로그인해야 해요. 관리자 페이지 > 백업·복원에 이번 복원 기록이 있어요." "Everyone signs in again. The admin console > Backup and restore shows this restore.")"
      else note "$(t "모두 다시 로그인해야 해요." "Everyone signs in again.")"; fi
      note "$(t "복원 전 데이터: $DIR/backups/$safety (필요 없으면 지워도 돼요)" "Data from before the restore: $DIR/backups/$safety (delete it when no longer needed)")"
      unusable_policy || true
      return 0
    fi
    reason=$(t "복원한 서버가 응답하지 않았어요." "The restored server did not answer.")
  fi
  # No retry: the safety backup goes back and the reason is said.
  warn "$(t "복원하지 못했어요: $reason" "The restore failed: $reason")"
  say "$(t "안전 백업으로 되돌려요." "Putting the safety backup back.")"
  compose stop broker >/dev/null 2>&1 || true
  if put_volume "$DIR/backups/$safety" whole && compose up -d >/dev/null 2>&1 && wait_ready; then
    fail "$(t "복원 전 상태로 되돌렸어요. 서버는 다시 실행 중이에요. 이유: $reason  기록: multitap logs" "Went back to the state before the restore. The server is running again. Reason: $reason  Log: multitap logs")"
  fi
  fail "$(t "되돌리기도 하지 못했어요. 이유: $reason  안전 백업 파일은 남아 있어요: $DIR/backups/$safety  되돌리려면: sudo multitap restore $DIR/backups/$safety  기록: multitap logs" "Going back failed too. Reason: $reason  The safety backup is still there: $DIR/backups/$safety  To put it back: sudo multitap restore $DIR/backups/$safety  Log: multitap logs")"
}

case "${1:-status}" in
  status)
    # What the container is doing now, in one line; when it is not answering,
    # the last lines of its log (never the one with the setup code).
    state='' health='' restarts='' release=''
    read -r state health restarts release <<< "$(container_line)" || true
    good=no
    if [ "$state" = running ] && [ "$health" = healthy ]; then
      good=yes
      ok "$(t "Multitap 서버 $release 실행 중이고 응답해요" "Multitap server $release is running and answering")"
    elif [ "$state" = running ] && [ "$health" = starting ]; then
      say "$(t "Multitap 서버 $release 시작하는 중이에요. 1분 안에 응답하지 않으면 아래 기록을 확인해 주세요." "Multitap server $release is starting. If it does not answer within a minute, check the log below.")"
    elif [ "$state" = running ]; then
      warn "$(t "Multitap 서버 $release 는 실행 중이지만 응답하지 않아요." "Multitap server $release is running but not answering.")"
    elif [ "$state" = restarting ]; then
      warn "$(t "Multitap 서버가 시작하지 못하고 계속 다시 시작되고 있어요." "The Multitap server cannot start and keeps restarting.")"
    else
      warn "$(t "Multitap 서버($(version))가 멈춰 있어요. 켜려면: multitap start" "Multitap server $(version) is stopped. To start it: multitap start")"
    fi
    if [[ $restarts =~ ^[0-9]+$ ]] && [ "$restarts" -gt 0 ]; then note "$(t "스스로 다시 시작한 횟수: $restarts" "Restarts on its own: $restarts")"; fi
    if [ "$state" = running ] && [ -n "$release" ] && [ "$release" != "$(version)" ]; then note "$(t "실행 중인 버전은 $release, 설정($DIR/.env)은 $(version)이에요. 맞추려면: multitap start" "Running release $release; the settings ($DIR/.env) say $(version). To bring them in line: multitap start")"; fi
    if [ "$good" != yes ] && [ -n "$state" ]; then
      note "$(t "서버 기록의 마지막 줄 (전체: multitap logs)" "The last lines of the server log (all of it: multitap logs)")"
      { compose logs --no-color --tail 8 broker 2>&1 | grep -v setupCode | cut -c1-240 | sed 's/^/      /'; } || true
    fi
    if access show; then
      note "$(t "주소 (관리자 페이지 > 서버 접속 설정)" "Addresses (admin console > Server access)")"
      show_addresses "$ACCESS"
    elif policy_unusable "$(kv code "$ACCESS")"; then
      say_unusable "$(kv code "$ACCESS")"
    else
      note "$(t "주소: $(access_reason "$(kv code "$ACCESS")")" "Addresses: $(access_reason "$(kv code "$ACCESS")")")"
    fi
    note "$(t "데이터: $(volume)   설정: $DIR/.env" "Data: $(volume)   Settings: $DIR/.env")"
    disk_space
    adopt_host_timer
    ;;
  logs) compose logs -f --tail 200 broker ;;
  code)
    # The last of the two lines the server logs: a code it issued, or first setup done.
    code=$( { compose logs --no-color broker 2>/dev/null | grep -o '"setupCode":"[^"]*"\|"event":"initial_setup_done"' | tail -n 1; } || true)
    case "$code" in *setupCode*) code=$(printf '%s' "$code" | sed 's/.*:"\(.*\)"/\1/') ;; *) code='' ;; esac
    if [ -n "$code" ]; then
      ok "$(t "설정 코드: ${YELLOW}$code${OFF}" "Setup code: ${YELLOW}$code${OFF}")"
    else
      ok "$(t "처음 설정을 이미 마친 서버예요. 만든 관리자 계정으로 로그인하세요." "First setup is already done on this server. Sign in with the admin account you created.")"
    fi
    ;;
  backup) backup ;;
  restore) shift; restore "$@" ;;
  public-ip)
    case "${2:-status}" in
      on)
        arguments=(public-ip on)
        # The address the earlier timer registered, else this machine's public
        # IP now: when the list already has it, it is the followed one at once.
        current=$(cat "$DIR/public-ip" 2>/dev/null || true)
        public_ipv4 "$current" || current=$(public_ip)
        [ -z "$current" ] || arguments+=(--address "$current")
        access "${arguments[@]}" || access_stop
        host_timer && remove_host_timer
        if [ -n "$(kv followed "$ACCESS")" ]; then
          ok "$(t "공인 IP 따라가기를 켰어요: $(kv followed "$ACCESS")" "Public IP following is on: $(kv followed "$ACCESS")")"
        else
          ok "$(t "공인 IP 따라가기를 켰어요. 서버가 지금 공인 IP를 확인해 주소로 등록해요. 보통 1분 안에 끝나요." "Public IP following is on. The server looks up its public IP now and registers the address, usually within a minute.")"
          note "$(t "등록할 때 서버가 다시 시작해서 접속 중인 연결이 한 번 끊겨요." "The server restarts itself when it registers the address: open connections end once.")"
        fi
        note "$(t "서버가 10분마다 확인하고, 바뀌면 알아서 바꿔요." "The server checks every 10 minutes and updates the address when the IP changes.")"
        follow_router_note "$ACCESS"
        warn "$(t "이 HTTP 주소는 인터넷을 지날 때 암호화되지 않아요. 밖에서 쓰려면 HTTPS 주소를 권해요." "This HTTP address is not encrypted over the internet. For use from outside, an HTTPS address is recommended.")"
        ;;
      off)
        access public-ip off || access_stop
        host_timer && remove_host_timer
        ok "$(t "공인 IP 따라가기를 껐어요. 등록한 주소는 그대로예요." "Public IP following is off. The registered address stays.")"
        ;;
      # Only the timer of release 1.1.1 runs this (see adopt_host_timer).
      sync) adopt_host_timer quiet ;;
      status)
        adopt_host_timer
        access public-ip status || access_stop
        if [ "$(kv follow "$ACCESS")" = 1 ] && [ -n "$(kv followed "$ACCESS")" ]; then
          ok "$(t "공인 IP 따라가기: 켜짐 ($(kv followed "$ACCESS"))" "Public IP following: on ($(kv followed "$ACCESS"))")"
        elif [ "$(kv follow "$ACCESS")" = 1 ]; then
          ok "$(t "공인 IP 따라가기: 켜짐 (아직 등록된 주소가 없어요)" "Public IP following: on (no address registered yet)")"
          note "$(t "서버가 공인 IP를 확인하는 대로 등록해요. 확인하지 못하면 10분마다 다시 해요." "The server registers it as soon as it finds its public IP. When it cannot, it tries again every 10 minutes.")"
        elif [ "$(kv followOffered "$ACCESS")" = 1 ]; then
          note "$(t "공인 IP 따라가기: 꺼짐. 켜려면 관리자 페이지 > 서버 접속 설정, 또는 multitap public-ip on" "Public IP following: off. To turn it on: admin console > Server access, or multitap public-ip on")"
        else
          note "$(t "공인 IP 따라가기: 꺼짐. 네트워크에 열린 HTTP 주소가 있어야 켤 수 있어요." "Public IP following: off. It needs an HTTP address that is open to the network.")"
        fi
        ;;
      *) fail "$(t "모르는 명령이에요: public-ip $2  (multitap public-ip on | off)" "Unknown command: public-ip $2  (multitap public-ip on | off)")" ;;
    esac
    ;;
  address)
    shift
    if [ $# -eq 0 ]; then
      adopt_host_timer
      if ! access show; then
        if policy_unusable "$(kv code "$ACCESS")"; then say_unusable "$(kv code "$ACCESS")" >&2; exit 1; fi
        fail "$(access_reason "$(kv code "$ACCESS")")"
      fi
      ok "$(t "지금 접속 주소" "Current addresses")"
      show_addresses "$ACCESS"
      [ -z "$(kv trustedProxies "$ACCESS")" ] || [ -z "$(kv https "$ACCESS")" ] || note "$(t "신뢰할 프록시: $(kv trustedProxies "$ACCESS")" "Trusted proxies: $(kv trustedProxies "$ACCESS")")"
      [ -z "$(kv pending "$ACCESS")" ] || note "$(t "관리자 페이지에서 저장한 설정을 적용하는 중이에요." "A change saved in the admin console is being applied.")"
      pf '  %s→%s 바꾸려면: 관리자 페이지 > 서버 접속 설정\n' '  %s→%s To change them: admin console > Server access\n' "$CYAN" "$OFF"
      note "$(t "관리자 페이지에 못 들어갈 때: multitap address <주소>...  (multitap address --help)" "When the console cannot be reached: multitap address <url>...  (multitap address --help)")"
      exit 0
    fi
    urls=() options=() reset=no plain=no
    while [ $# -gt 0 ]; do
      case "$1" in
        --primary|--trusted-proxies)
          [ $# -ge 2 ] || fail "$(t "$1 뒤에 값을 넣어 주세요.  (multitap address --help)" "$1 needs a value.  (multitap address --help)")"
          value=$2; [ "$1" != --primary ] || value=${value%/}
          options+=("$1" "$value"); shift 2 ;;
        --reset) reset=yes; shift ;;
        -*) fail "$(t "모르는 옵션이에요: $1  (multitap address --help)" "Unknown option: $1  (multitap address --help)")" ;;
        http://*) urls+=("${1%/}"); plain=yes; shift ;;
        https://*) urls+=("${1%/}"); shift ;;
        *) fail "$(t "http:// 또는 https://로 시작하는 주소를 넣어 주세요: $1" "Enter an address that starts with http:// or https://: $1")" ;;
      esac
    done
    [ "${#urls[@]}" -gt 0 ] || fail "$(t "주소를 하나 이상 넣어 주세요.  (multitap address --help)" "Give at least one address.  (multitap address --help)")"
    # Whether a policy is saved now: only then is there one to put back.
    saved=no followed=''
    if access show; then
      [ "$(kv source "$ACCESS")" != saved ] || saved=yes
      [ "$(kv follow "$ACCESS")" != 1 ] || followed=$(kv followed "$ACCESS")
    elif [ "$reset" != yes ] || [ -z "$(kv code "$ACCESS")" ]; then fail "$(access_reason "$(kv code "$ACCESS")") $(t "아무것도 바꾸지 않았어요." "Nothing was changed.")"
    fi
    cp "$DIR/.env" "$DIR/.env.previous"
    # .env first: access-cli checks the addresses against the port this
    # container will publish. HTTP reaches the published port directly.
    port=$(publish_port "${urls[@]}")
    [ -z "$port" ] || set_env MULTITAP_PUBLISH_PORT "0.0.0.0:$port"
    # Following stays on beside an HTTP address: the server would register its
    # public address again half a minute after the restart below and restart
    # once more. The address it follows stays in the list instead, at the port
    # Docker opens from now on, so connections end once.
    if [ -n "$followed" ] && [ "$plain" = yes ] && [ "$reset" != yes ]; then
      keep="${followed%:*}:$port" count=0
      for value in "${urls[@]}"; do
        case "$value" in http://*) count=$((count + 1)) ;; esac
        [ "$value" != "$keep" ] || keep=''
      done
      if [ -n "$keep" ] && [ "$count" -lt 4 ]; then urls+=("$keep"); fi
    fi
    drop_env_seed
    # Without an HTTP address there is nothing to follow the public IP with.
    [ "$plain" = yes ] || options+=(--follow off)
    # A stopped server cannot finish a save from the console: this one goes on.
    running || options+=(--force)
    if [ "$reset" = yes ]; then
      if ! access reset && ! clear_access; then
        cp "$DIR/.env.previous" "$DIR/.env"
        fail "$(t "저장된 설정을 지우지 못했어요. 아무것도 바꾸지 않았어요. Docker가 실행 중인지 확인해 주세요." "Could not remove the saved settings. Nothing was changed. Check that Docker is running.")"
      fi
      saved=no
    fi
    if ! access set "${urls[@]}" ${options[@]+"${options[@]}"}; then
      cp "$DIR/.env.previous" "$DIR/.env"
      if [ "$(kv code "$ACCESS")" = server_access_public_ip_conflict ]; then
        fail "$(t "공인 IP 따라가기가 켜져 있어서 이 주소들로는 바꿀 수 없어요. 다른 HTTP 주소를 함께 넣거나 먼저 multitap public-ip off 를 해 주세요." "Public IP following is on, so these addresses cannot be set. Give another HTTP address as well, or run multitap public-ip off first.")"
      fi
      [ "$reset" != yes ] || fail "$(access_reason "$(kv code "$ACCESS")") $(t "읽을 수 없던 저장 설정은 지웠어요. 주소를 다시 정해 주세요." "The saved settings that could not be read are removed. Set the addresses again.")"
      fail "$(access_reason "$(kv code "$ACCESS")") $(t "주소는 그대로예요." "The addresses are unchanged.")"
    fi
    result=$ACCESS
    # This run wrote the policy when it changed it, or when none was saved yet.
    wrote=no
    if [ "$(kv changed "$result")" = 1 ] || [ "$saved" != yes ]; then wrote=yes; fi
    if [ "$wrote" != yes ] && cmp -s "$DIR/.env" "$DIR/.env.previous"; then
      ok "$(t "이미 그 주소예요." "These are already the addresses.")"
      list_addresses "$result"
      exit 0
    fi
    say "$(t "서버를 새 주소로 다시 시작해요. 접속 중인 연결은 끊겨요." "Restarting the server with the new addresses. Open connections end.")"
    compose up -d --force-recreate >/dev/null 2>&1 || true
    if wait_ready; then
      ok "$(t "접속 주소를 바꿨어요. 앱과 Host에는 이 주소를 넣으세요." "Addresses changed. Enter one of these in apps and Hosts.")"
      list_addresses "$result"
      [ "$plain" != yes ] || warn "$(t "HTTP는 암호화되지 않아요. 믿을 수 있는 내부 네트워크에서만 쓰세요." "HTTP is not encrypted. Use it only on an internal network you trust.")"
    else
      warn "$(t "새 주소로 시작하지 못해 전 설정으로 되돌려요." "The server did not start with the new addresses; going back to the previous settings.")"
      compose stop broker >/dev/null 2>&1 || true
      back=yes
      if [ "$wrote" = yes ]; then access revert --force || back=no; fi
      cp "$DIR/.env.previous" "$DIR/.env"
      compose up -d --force-recreate >/dev/null 2>&1 || true
      if [ "$back" = yes ] && wait_ready; then
        fail "$(t "주소를 바꾸지 못했어요. 전 설정으로 되돌렸고 서버는 다시 실행 중이에요. 기록: multitap logs" "Could not change the addresses. The previous settings are back and the server is running again. Log: multitap logs")"
      fi
      fail "$(t "주소를 바꾸지 못했고, 전 설정으로 되돌린 서버도 응답하지 않아요. 기록: multitap logs" "Could not change the addresses, and the server does not answer with the previous settings either. Log: multitap logs")"
    fi
    ;;
  restart)
    say "$(t "다시 시작해요." "Restarting.")"
    compose restart broker >/dev/null 2>&1 || fail "$(t "다시 시작하지 못했어요. 기록: multitap logs" "Could not restart. Log: multitap logs")"
    wait_ready || { unusable_policy || true; fail "$(t "다시 시작했지만 서버가 응답하지 않아요. 기록: multitap logs" "Restarted, but the server does not answer. Log: multitap logs")"; }
    ok "$(t "다시 시작했어요." "Restarted.")"
    unusable_policy || true
    ;;
  stop) compose stop broker >/dev/null 2>&1 && ok "$(t "멈췄어요. 다시 켜려면: multitap start" "Stopped. To start it again: multitap start")" ;;
  start)
    say "$(t "시작해요." "Starting.")"
    compose up -d >/dev/null 2>&1 || fail "$(t "시작하지 못했어요. 기록: multitap logs" "Could not start. Log: multitap logs")"
    wait_ready || { unusable_policy || true; fail "$(t "시작했지만 서버가 응답하지 않아요. 기록: multitap logs" "Started, but the server does not answer. Log: multitap logs")"; }
    ok "$(t "시작했어요." "Started.")"
    if access show; then show_addresses "$ACCESS"; elif policy_unusable "$(kv code "$ACCESS")"; then say_unusable "$(kv code "$ACCESS")"; fi
    ;;
  update)
    current=$(version)
    target=${2:-$(newest_version)}
    case "$target" in [0-9]*.[0-9]*.[0-9]*) ;; *) fail "$(t "버전을 알 수 없어요: $target" "Unknown version: $target")" ;; esac
    if [ "$target" = "$current" ] && running; then ok "$(t "이미 $current이에요." "Already on $current.")"; exit 0; fi
    # Without a version the newest public release is the target, and it never
    # takes the server back: a server on a newer release than that one stays.
    # Going back is asked for by name (multitap update 1.2.3).
    if [ -z "${2:-}" ] && older_release "$target" "$current"; then
      ok "$(t "지금 $current은 공개된 최신 버전($target)보다 새 버전이에요. 바꾼 것은 없어요." "This server runs $current, which is newer than the latest public release ($target). Nothing was changed.")"
      note "$(t "예전 버전으로 돌아가려면 버전을 적어요: multitap update $target" "To go back to an earlier release, name it: multitap update $target")"
      exit 0
    fi
    say "$(t "Multitap 서버 $current → $target" "Multitap server $current → $target")"
    if ! docker image inspect "$(image):$target" >/dev/null 2>&1; then
      docker pull --quiet "$(image):$target" >/dev/null || fail "$(t "$target 이미지를 받지 못했어요. 지금 서버는 그대로예요." "Could not download the $target image. The current server is unchanged.")"
    fi
    backup update
    prune_update_copies
    # The new release's compose file, kept beside the previous one.
    if [ -z "${MULTITAP_LOCAL:-}" ]; then
      if curl -fsSL "https://raw.githubusercontent.com/$REPOSITORY/v$target/compose.yaml" -o "$DIR/compose.yaml.new"; then
        cp "$DIR/compose.yaml" "$DIR/compose.yaml.previous"; mv "$DIR/compose.yaml.new" "$DIR/compose.yaml"
      fi
      curl -fsSL "https://raw.githubusercontent.com/$REPOSITORY/v$target/deploy/docker/multitap" -o /usr/local/bin/multitap.new \
        && chmod 0755 /usr/local/bin/multitap.new && mv /usr/local/bin/multitap.new /usr/local/bin/multitap || true
    fi
    cp "$DIR/.env" "$DIR/.env.previous"
    # The container is recreated now: address lines that a saved policy has
    # superseded go (see "server access" above). A server that does not know
    # the command yet gives no answer, and its lines stay. A release from
    # before the saved policy gets the saved addresses as its lines instead.
    policy=''
    if access show && [ "$(kv source "$ACCESS")" = saved ]; then policy=$ACCESS; fi
    set_env MULTITAP_VERSION "$target"
    if [ -n "$policy" ]; then
      if knows_policy; then drop_env_seed; else write_env_seed "$policy"; fi
    fi
    compose up -d --quiet-pull >/dev/null 2>&1 || true
    say "$(t "새 버전이 응답하기를 기다려요." "Waiting for the new version to answer.")"
    if wait_ready "$target"; then
      ok "$(t "$target 버전으로 올렸어요. 데이터는 그대로예요." "Updated to $target. Your data is unchanged.")"
      # Run again on the same release, the one before it is not known here:
      # nothing is removed, so the way back stays.
      [ "$target" = "$current" ] || prune_images "$target" "$current"
      unusable_policy || adopt_host_timer
    else
      warn "$(t "새 버전이 응답하지 않아 $current 버전으로 되돌려요." "The new version did not answer; going back to $current.")"
      cp "$DIR/.env.previous" "$DIR/.env"
      [ -f "$DIR/compose.yaml.previous" ] && cp "$DIR/compose.yaml.previous" "$DIR/compose.yaml"
      compose up -d >/dev/null 2>&1 || true
      if wait_ready "$current"; then
        fail "$(t "$target 버전이 시작하지 않았어요. $current 버전으로 되돌렸고 서버는 다시 실행 중이에요. 기록: multitap logs" "$target did not start. Went back to $current and the server is running again. Log: multitap logs")"
      fi
      fail "$(t "$target 버전이 시작하지 않았고, 되돌린 $current 버전도 응답하지 않아요. 기록: multitap logs  백업: $DIR/backups" "$target did not start, and $current does not answer after going back either. Log: multitap logs  Backups: $DIR/backups")"
    fi
    ;;
  uninstall)
    pf '서버를 멈추고 지워요. 데이터(%s)와 %s 는 남겨요. 계속할까요? [y/N] ' \
       'This stops and removes the server. The data (%s) and %s stay. Continue? [y/N] ' "$(volume)" "$DIR"
    { read -r answer </dev/tty; } 2>/dev/null || answer=n
    case "$answer" in y|Y|yes) ;; *) ok "$(t "취소했어요." "Cancelled.")"; exit 0 ;; esac
    compose down >/dev/null 2>&1
    remove_host_timer
    rm -f /usr/local/bin/multitap "$DIR/.installed"
    ok "$(t "서버를 지웠어요." "Server removed.")"
    note "$(t "데이터까지 지우려면:  docker volume rm $(volume) && rm -rf $DIR" "To remove the data too:  docker volume rm $(volume) && rm -rf $DIR")"
    note "$(t "다시 설치하면 남은 데이터로 그대로 시작해요." "Installing again starts with the data that is left.")"
    ;;
  *) fail "$(t "모르는 명령이에요: $1  (multitap help)" "Unknown command: $1  (multitap help)")" ;;
esac
